+            hook = lambda: h.state.attributes.update(hvac_action="defrosting")
+        else:
+            hook = lambda: h.plan.update(sleeping=True)
+        h.store.hook = hook
+        await tick(h)
+        assert h.hass.services.calls == []
+        assert not h.runtime.records[h.spec.identifier].get("pending")
+    asyncio.run(run())
